 "panic_open_3": {
  "src": "/show/wide/panic_open_3.mp4",
  "duration": 25.48,
  "speech": {
   "start": 0.0,
   "end": 24.72
  },
  "lines": [
   {
    "host": "marcus",
    "text": "Welcome to Panic Mode.",
    "start": 0.6,
    "end": 2.44
   },
   {
    "host": "tony",
    "text": "My favorite half hour of the week.",
    "start": 2.44,
    "end": 5.1
   },
   {
    "host": "marcus",
    "text": "For the new folks. We go through everything this team has going on, and every piece of it either feeds the panic, or calms it down.",
    "start": 5.1,
    "end": 12.22
   },
   {
    "host": "tony",
    "text": "Then we each put a number on it. One, you're fine. Ten, somebody call the owner.",
    "start": 12.22,
    "end": 17.9
   },
   {
    "host": "marcus",
    "text": "And Tony has never said a number under six.",
    "start": 18.9,
    "end": 22.06
   },
   {
    "host": "tony",
    "text": "Because nobody's ever earned it.",
    "start": 22.06,
    "end": 24.72
   }
  ],
  "shots": "ccccPP"
 },
 "contender_open_3": {
  "src": "/show/wide/contender_open_3.mp4",
  "duration": 24.84,
  "speech": {
   "start": 0.0,
   "end": 24.08
  },
  "lines": [
   {
    "host": "tony",
    "text": "Contender or Pretender. Let's go.",
    "start": 0.6,
    "end": 3.36
   },
   {
    "host": "marcus",
    "text": "The record is the record. The question is whether it holds up when the games get real.",
    "start": 3.36,
    "end": 8.35
   },
   {
    "host": "tony",
    "text": "So we go through what's real and what's fake, and then we stamp it.",
    "start": 8.35,
    "end": 12.7
   },
   {
    "host": "marcus",
    "text": "Contender, or pretender. One word each. No 'it depends'.",
    "start": 12.7,
    "end": 17.44
   },
   {
    "host": "tony",
    "text": "I have never once said 'it depends'.",
    "start": 18.44,
    "end": 22.14
   },
   {
    "host": "marcus",
    "text": "You said it twice last week.",
    "start": 22.14,
    "end": 24.08
   }
  ],
  "shots": "ccccpP"
 },
