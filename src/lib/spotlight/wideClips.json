    "text": "Alright, stamps out. Contender or pretender. I'm going first, because I'm not scared.",
    "start": 0.6,
    "end": 4.96
   },
   {
    "host": "marcus",
    "text": "You're never scared. You're just wrong a lot.",
    "start": 4.96,
    "end": 7.0
   }
  ],
  "shots": "cp"
 },
