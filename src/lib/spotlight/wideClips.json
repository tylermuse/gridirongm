{
 "panic_open_1": {
  "src": "/show/wide/panic_open_1.mp4",
  "duration": 22.72,
  "speech": {
   "start": 0.0,
   "end": 22.2
  },
  "lines": [
   {
    "host": "marcus",
    "text": "Alright. You know what time it is.",
    "start": 0.0,
    "end": 1.6
   },
   {
    "host": "tony",
    "text": "Oh, it's time. It's Panic Mode.",
    "start": 1.6,
    "end": 4.22
   },
   {
    "host": "marcus",
    "text": "Rules, for anybody new. I make the case this team's in trouble, Tony makes the case it isn't\u2014",
    "start": 4.22,
    "end": 8.96
   },
   {
    "host": "tony",
    "text": "\u2014or the other way around, depending how I feel.",
    "start": 9.96,
    "end": 12.84
   },
   {
    "host": "marcus",
    "text": "And at the end, we both put a number on it. One, totally fine. Ten, hit the button.",
    "start": 12.84,
    "end": 17.78
   },
   {
    "host": "tony",
    "text": "And for the record, I've never gone below a six in my life.",
    "start": 17.78,
    "end": 22.2
   }
  ],
  "shots": "cccPpP"
 },
 "panic_open_2": {
  "src": "/show/wide/panic_open_2.mp4",
  "duration": 20.56,
  "speech": {
   "start": 0.0,
   "end": 20.2
  },
  "lines": [
   {
    "host": "tony",
    "text": "Marcus. I've got my hand over the button.",
    "start": 0.0,
    "end": 2.24
   },
   {
    "host": "marcus",
    "text": "Of course you do. Welcome to Panic Mode, everybody.",
    "start": 3.24,
    "end": 6.72
   },
   {
    "host": "tony",
    "text": "Simple game. Is it time to panic on this team, or is everybody overreacting?",
    "start": 6.72,
    "end": 11.72
   },
   {
    "host": "marcus",
    "text": "We argue it out, then we each give it a number. One to ten. Ten means blow the whole thing up.",
    "start": 11.72,
    "end": 16.76
   },
   {
    "host": "tony",
    "text": "One means relax, go make a sandwich, you're fine.",
    "start": 16.76,
    "end": 20.2
   }
  ],
  "shots": "Pcccc"
 },
