    "start": 0.0,
    "end": 3.9
   },
   {
    "host": "marcus",
    "text": "Let me think about this for a second.",
    "start": 3.9,
    "end": 6.96
   }
  ],
  "shots": "cp"
 },
 "buysell_open_1": {
  "src": "/show/wide/buysell_open_1.mp4",
  "duration": 20.04,
  "speech": {
   "start": 0.0,
   "end": 19.68
  },
  "lines": [
   {
    "host": "marcus",
    "text": "Time for Buy or Sell.",
    "start": 0.0,
    "end": 2.72
   },
   {
    "host": "tony",
    "text": "My favorite game. I've been buying since breakfast.",
    "start": 2.72,
    "end": 5.84
   },
   {
    "host": "marcus",
    "text": "Here's how it works. I put something on the board. A player, a number, a take that's going around\u2014",
    "start": 5.84,
    "end": 11.36
   },
   {
    "host": "tony",
    "text": "\u2014and we tell you if we're buying it, or selling it.",
    "start": 11.36,
    "end": 14.48
   },
   {
    "host": "marcus",
    "text": "And there's no hold. You have to pick a side.",
    "start": 14.48,
    "end": 17.36
   },
   {
    "host": "tony",
    "text": "Hold is for cowards, Marcus.",
    "start": 17.36,
    "end": 19.68
   }
  ],
  "shots": "cpcccp"
 },
 "buysell_open_2": {
  "src": "/show/wide/buysell_open_2.mp4",
  "duration": 12.52,
  "speech": {
   "start": 0.0,
   "end": 12.16
  },
  "lines": [
   {
    "host": "tony",
    "text": "We're playing Buy or Sell today.",
    "start": 0.0,
    "end": 1.92
   },
   {
    "host": "marcus",
    "text": "Three things on the board. For each one, buy or sell. No hedging.",
    "start": 1.92,
    "end": 6.24
   },
   {
    "host": "tony",
    "text": "He says no hedging like he doesn't hedge every single week.",
    "start": 6.24,
    "end": 9.84
   },
   {
    "host": "marcus",
    "text": "I commit. Eventually.",
    "start": 9.84,
    "end": 12.16
   }
  ],
  "shots": "ccpp"
 },
 "contender_open_1": {
  "src": "/show/wide/contender_open_1.mp4",
  "duration": 18.6,
  "speech": {
   "start": 0.0,
   "end": 18.24
  },
  "lines": [
   {
    "host": "tony",
    "text": "It's Contender or Pretender, baby.",
    "start": 0.0,
    "end": 2.48
   },
   {
    "host": "marcus",
    "text": "One question. When it's January and the weather turns, is this team still standing?",
    "start": 2.48,
    "end": 7.92
   },
   {
    "host": "tony",
    "text": "We look at what's real, and what's smoke\u2014",
    "start": 7.92,
    "end": 10.8
   },
   {
    "host": "marcus",
    "text": "\u2014and at the end, we each stamp it. Contender, or pretender.",
    "start": 10.8,
    "end": 14.91
   },
   {
    "host": "tony",
    "text": "Loser buys lunch.",
    "start": 14.91,
    "end": 16.56
   },
   {
    "host": "marcus",
    "text": "You still owe me two lunches.",
    "start": 16.56,
    "end": 18.24
   }
  ],
  "shots": "ccccpp"
 },
 "contender_open_2": {
  "src": "/show/wide/contender_open_2.mp4",
  "duration": 15.2,
  "speech": {
   "start": 0.0,
   "end": 14.8
  },
  "lines": [
   {
    "host": "marcus",
    "text": "Contender or Pretender. Here's the game. The record says one thing. We figure out if it's lying.",
    "start": 0.0,
    "end": 5.46
   },
   {
    "host": "tony",
    "text": "Records lie all the time, Marcus. Mine says I'm undefeated at karaoke.",
    "start": 5.46,
    "end": 10.0
   },
   {
    "host": "marcus",
    "text": "That's because nobody's ever let you finish a song.",
    "start": 10.0,
    "end": 12.56
   },
   {
    "host": "tony",
    "text": "Fair. That's fair.",
    "start": 12.56,
    "end": 14.8
   }
  ],
  "shots": "cppp"
 },
 "contender_verdict_1": {
  "src": "/show/wide/contender_verdict_1.mp4",
