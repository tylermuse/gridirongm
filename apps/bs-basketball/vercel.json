{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run build --workspace=apps/bs-basketball",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/rebuild-predictions",
      "schedule": "0 12 * * 1"
    }
  ]
}
